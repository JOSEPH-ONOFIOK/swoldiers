# ---- Required in production ----
# Long random string. Signs sessions and sign-in messages. Generate: openssl rand -base64 32
SESSION_SECRET=
# Password for /admin (review follows and comments, missions, CSV export)
ADMIN_PASSWORD=
# Upstash Redis (free tier is fine): https://console.upstash.com → create a Redis database → REST API
# Without these, `npm run dev` stores data in .data/db.json; production refuses to run the whitelist.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: a readable copy of the whitelist in a Google Sheet (setup: scripts/apps-script/README.md).
GOOGLE_SHEETS_WEBAPP_URL=
# Must match SHARED_SECRET in the Apps Script project's Script Properties
SHEETS_WEBHOOK_SECRET=

# ---- Site (read at build time: redeploy after changing) ----
NEXT_PUBLIC_SITE_URL=https://swoldiers.xyz
# X account without the @
NEXT_PUBLIC_X_ACCOUNT=swoldiers_
# The announcement post people comment $SWOL on and repost for step 3
NEXT_PUBLIC_X_POST=https://x.com/swoldiers_/status/...
# When the whitelist closes (UTC). Empty = open with no end.
NEXT_PUBLIC_WHITELIST_END=2026-11-20T20:00:00Z
# Set to 1 to close the whitelist right now
NEXT_PUBLIC_WHITELIST_CLOSED=
# Game launch time (UTC). The Play button says "Play now" from this time. Until then it opens the demo as "Play the demo".
NEXT_PUBLIC_LAUNCH_AT=

# ---- Token (leave empty until it exists; the site says "Coming soon") ----
NEXT_PUBLIC_TOKEN_CHAIN=
NEXT_PUBLIC_TOKEN_CA=
NEXT_PUBLIC_TOKEN_EXPLORER=

# Set to 1 after the whitelist closes and the last checks are done: the leaderboard shows as final.
WHITELIST_FINAL=
